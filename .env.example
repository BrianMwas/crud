# Database configuration
DATABASE_URL=postgresql://user:password@localhost:5432/fastapi_db

# Auth0 configuration
AUTH0_API_AUDIENCE=your-api-audience

# Auth0 Machine-to-Machine application settings
AUTH0_DOMAIN=your-auth0-domain.auth0.com
AUTH0_CLIENT_ID=your-m2m-client-id
AUTH0_CLIENT_SECRET=your-m2m-client-secret

# Auth0 Web application settings (for user authentication)
AUTH0_WEB_CLIENT_DOMAIN=your-auth0-domain.auth0.com
AUTH0_WEB_CLIENT_ID=your-web-client-id
AUTH0_WEB_CLIENT_SECRET=your-web-client-secret
